+// kipferl patch: allow setting function.__doc__ for CPython compatibility
+static bool function__doc__set(int argc, py_Ref argv) {
+    PY_CHECK_ARGC(2);
+    Function* func = py_touserdata(py_arg(0));
+    py_Ref val = py_arg(1);
+    // kipferl patch: the declaration owns its docstring; free the replaced one
+    if(!py_isnone(val)) PY_CHECK_ARG_TYPE(1, tp_str);
+    if(func->decl->docstring) py_free(func->decl->docstring);
+    if(py_isnone(val)) {
+        func->decl->docstring = NULL;
+        py_newnone(py_retval());
+        return true;
+    }
+    func->decl->docstring = c11_strdup(py_tostr(val));
+    py_newnone(py_retval());
+    return true;
+}
+
 static bool function__name__(int argc, py_Ref argv) {
     PY_CHECK_ARGC(1);
     Function* func = py_touserdata(py_arg(0));
     py_newstr(py_retval(), func->decl->code.name->data);
+    return true;
+}
+
+// kipferl patch: allow setting function.__name__ for CPython compatibility
+static bool function__name__set(int argc, py_Ref argv) {
+    PY_CHECK_ARGC(2);
+    Function* func = py_touserdata(py_arg(0));
+    PY_CHECK_ARG_TYPE(1, tp_str);
+    const char* s = py_tostr(py_arg(1));
+    c11_string__delete(func->decl->code.name);
+    func->decl->code.name = c11_string__new(s);
+    py_newnone(py_retval());
     return true;
 }
 
