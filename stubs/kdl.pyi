"""KDL v2 parsing and serialization backed by native Rust."""

from typing import Any, List, Optional

Scalar = Any
Entry = dict
Node = dict
Document = List[Node]

def loads(text: str) -> Document: ...
def load(source: Any) -> Document: ...
def dumps(document: Document) -> str: ...
def dump(document: Document, stream: Optional[Any] = None) -> Optional[str]: ...
def argument(value: Scalar, type: Optional[str] = None) -> Entry: ...
def property(name: str, value: Scalar, type: Optional[str] = None) -> Entry: ...
def node(
    name: str,
    entries: Optional[List[Entry]] = None,
    children: Optional[Document] = None,
    type: Optional[str] = None,
) -> Node: ...
