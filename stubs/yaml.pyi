"""YAML 1.2 parsing and serialization backed by native Rust."""

from typing import Any, Optional

def loads(text: str) -> Any: ...
def safe_load(text: str) -> Any: ...
def load(source: Any) -> Any: ...
def dumps(data: Any) -> str: ...
def safe_dump(data: Any, stream: Optional[Any] = None) -> Optional[str]: ...
def dump(data: Any, stream: Optional[Any] = None) -> Optional[str]: ...
